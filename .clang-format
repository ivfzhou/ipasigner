# 指定格式化的语言为 C++。
Language: Cpp

# 基于 LLVM 代码风格作为基础样式。
BasedOnStyle: LLVM

# 访问修饰符（public/private/protected）相对于类体缩进偏移 -2 个空格。
AccessModifierOffset: -2

# 不对齐连续的赋值语句中的等号。
AlignConsecutiveAssignments: false

# 不对齐多行表达式中的操作数。
AlignOperands: false

# 不对齐行尾注释。
AlignTrailingComments: false

# 允许短 if 语句写在同一行。
AllowShortIfStatementsOnASingleLine: true

# 允许短循环语句写在同一行。
AllowShortLoopsOnASingleLine: true

# 大括号换行风格使用自定义规则。
BreakBeforeBraces: Custom

# 每行最大列宽限制为 120 个字符。
ColumnLimit: 120

# 不在命名空间结尾的大括号后自动添加注释（如 // namespace xxx）。
FixNamespaceComments: false

# 缩进宽度为 4 个空格。
IndentWidth: 4

# 在文件末尾自动插入一个换行符。
InsertNewlineAtEOF: true

# 最多保留 2 个连续空行。
MaxEmptyLinesToKeep: 2

# 指针符号 * 靠左对齐（紧跟类型，如 int* p）。
PointerAlignment: Left

# Tab 字符的显示宽度为 4 个空格。
TabWidth: 4

# 始终使用空格缩进，不使用 Tab 字符。
UseTab: Never
